# Choose one provider. Leave all keys empty for rules-only mode (local dev / CI).
AGENT_GATE_PROVIDER=openai         # openai | anthropic | gemini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1   # Groq/Mistral/Together/Ollama... also work
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MODEL=                              # default per provider: gpt-4o-mini / claude-sonnet-5 / gemini-2.5-flash

# Optional HMAC secret shared with HttpDecider(signingSecret: ...) in the app.
AGENT_GATE_SIGNING_SECRET=
AGENT_GATE_REPLAY_WINDOW_MS=300000
