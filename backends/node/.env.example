# Provider (any OpenAI-compatible chat-completions API works: OpenAI, Groq,
# Mistral, Together, OpenRouter, Ollama, vLLM …). Leave OPENAI_API_KEY empty to
# run in RULES_ONLY mode (no model call; useful for local dev and CI).
OPENAI_API_KEY=
OPENAI_BASE_URL=            # e.g. https://api.groq.com/openai/v1  (optional)
MODEL=gpt-4o-mini

# Optional HMAC secret shared with HttpDecider(signingSecret: ...) in the app.
AGENT_GATE_SIGNING_SECRET=
AGENT_GATE_REPLAY_WINDOW_MS=300000

PORT=8787
